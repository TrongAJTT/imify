{
  "name": "@imify/features",
  "version": "2.2.2",
  "private": true,
  "description": "Shared, platform-agnostic feature modules for Imify",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@imify/stores": "workspace:*",
    "@imify/ui": "workspace:*",
    "@imify/i18n": "workspace:*",
    "i18next": "^23.11.5",
    "react-i18next": "^14.1.2",
    "jsqr": "^1.4.0",
    "konva": "^10.2.5",
    "markdown-to-jsx": "^9.7.16",
    "qr-code-styling": "^1.8.4",
    "react-konva": "^18.2.14",
    "woff2-encoder": "^2.0.0"
  },
  "alias": {
    "sharp": false,
    "@huggingface/transformers": "@huggingface/transformers/dist/transformers.web.js"
